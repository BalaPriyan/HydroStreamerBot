# ---------------------------------------------
# HydroStreamerBot Environment Variables
# ---------------------------------------------

# Telegram API Setup (my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Bot Setup (@BotFather)
BOT_TOKEN=your_bot_token_here

# Ownership & Channels
OWNER_ID=your_telegram_user_id
BIN_CHANNEL=-1001234567890
UPDATES_CHANNEL=YourUpdatesChannelWithout@

# Database & Cache Information
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/test
REDIS_URL=redis://redis:6379

# App Execution Mapping
RUN_MODE=ALL  # Options: ALL, BOT, WEB (Handled by Docker Compose usually)
SESSION_NAME=HydroStreamerBot
SLEEP_THRESHOLD=60
WORKERS=6
KEEP_ALIVE=False

# Server Specifications
PORT=8080
WEB_SERVER_BIND_ADDRESS=0.0.0.0
NO_PORT=False
HAS_SSL=False

# Optional Feature Limits
# LINK_LIMIT=10
# TOS=https://your-terms-of-service-url.com
# ALLOWED_USERS=user1,user2
